{
  "name": "patolab",
  "private": true,
  "description": "Comandos de desarrollo de PathoLab: levantar backend y frontend con un solo comando, revisar formato y linter, y correr las pruebas de punta a punta (Cypress).",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test scripts/*.test.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:abrir": "node scripts/e2e.mjs --abrir",
    "e2e:video": "node scripts/e2e.mjs --video",
    "e2e:presentacion": "node scripts/e2e.mjs --presentacion"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
